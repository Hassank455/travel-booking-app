erDiagram

    %% =========================================================
    %% IDENTITY
    %% =========================================================

    USERS {
        bigint id PK
        string email UK
        string password_hash
        string status
        datetime email_verified_at
        datetime created_at
        datetime updated_at
    }

    ROLES {
        bigint id PK
        string code UK
        string name
        datetime created_at
    }

    USER_ROLES {
        bigint user_id FK
        bigint role_id FK
        datetime created_at
    }

    %% =========================================================
    %% CUSTOMER
    %% =========================================================

    CUSTOMERS {
        bigint id PK
        bigint user_id FK
        string first_name
        string last_name
        string phone_number
        datetime created_at
        datetime updated_at
    }

    ADDRESSES {
        bigint id PK
        bigint customer_id FK
        string line1
        string line2
        string city
        string state
        string postal_code
        string country_code
        string type
        boolean is_default
        datetime created_at
        datetime updated_at
    }

    TRAVELER_PROFILES {
        bigint id PK
        bigint customer_id FK
        string first_name
        string last_name
        date date_of_birth
        string gender
        string nationality
        string document_type
        string document_number
        date document_expiry
        datetime created_at
        datetime updated_at
    }

    %% =========================================================
    %% PROVIDERS
    %% =========================================================

    PROVIDERS {
        bigint id PK
        string name
        string code UK
        string type
        string status
        datetime created_at
        datetime updated_at
    }

    %% =========================================================
    %% TRANSACTIONS
    %% =========================================================

    TRANSACTIONS {
        bigint id PK
        bigint customer_id FK
        bigint provider_id FK
        string provider_transaction_reference
        string status
        string payment_method
        decimal amount
        string currency
        datetime authorized_at
        datetime completed_at
        datetime created_at
        datetime updated_at
    }

    %% =========================================================
    %% FLIGHT BOOKING
    %% =========================================================

    FLIGHT_BOOKINGS {
        bigint id PK
        bigint customer_id FK
        bigint transaction_id FK
        bigint provider_id FK
        string provider_offer_reference
        string provider_booking_reference
        string provider_confirmation_reference
        string status
        string trip_type
        decimal total_amount
        string currency
        datetime booked_at
        datetime created_at
        datetime updated_at
    }

    FLIGHT_BOOKING_PASSENGERS {
        bigint id PK
        bigint flight_booking_id FK
        bigint traveler_profile_id FK
        string first_name
        string last_name
        date date_of_birth
        string passenger_type
        string gender
        string nationality
        string document_type
        string document_number
        date document_expiry
        datetime created_at
    }

    FLIGHT_SEGMENTS {
        bigint id PK
        bigint flight_booking_id FK
        int segment_order
        string origin_iata_code
        string destination_iata_code
        datetime departure_at
        datetime arrival_at
        string marketing_carrier
        string operating_carrier
        string flight_number
        string cabin_class
        string booking_class
        datetime created_at
    }

    FLIGHT_BOOKING_STATUS_HISTORY {
        bigint id PK
        bigint flight_booking_id FK
        string previous_status
        string new_status
        string reason
        string source
        datetime changed_at
    }

    %% =========================================================
    %% HOTEL BOOKING
    %% =========================================================

    HOTEL_BOOKINGS {
        bigint id PK
        bigint customer_id FK
        bigint transaction_id FK
        bigint provider_id FK
        string provider_offer_reference
        string provider_booking_reference
        string provider_confirmation_reference
        string status
        string hotel_reference
        date check_in_date
        date check_out_date
        decimal total_amount
        string currency
        datetime booked_at
        datetime created_at
        datetime updated_at
    }

    HOTEL_BOOKING_GUESTS {
        bigint id PK
        bigint hotel_booking_id FK
        bigint traveler_profile_id FK
        string first_name
        string last_name
        string email
        string phone_number
        date date_of_birth
        string guest_type
        boolean is_primary_guest
        datetime created_at
    }

    HOTEL_BOOKING_ROOMS {
        bigint id PK
        bigint hotel_booking_id FK
        string provider_room_reference
        string provider_rate_reference
        string room_name
        string room_type
        string rate_name
        string meal_plan
        int adult_count
        int child_count
        decimal room_amount
        string currency
        string cancellation_policy
        datetime created_at
    }

    HOTEL_BOOKING_ROOM_GUESTS {
        bigint hotel_booking_room_id FK
        bigint hotel_booking_guest_id FK
    }

    HOTEL_BOOKING_STATUS_HISTORY {
        bigint id PK
        bigint hotel_booking_id FK
        string previous_status
        string new_status
        string reason
        string source
        datetime changed_at
    }

    %% =========================================================
    %% NOTIFICATIONS / AUDIT
    %% =========================================================

    NOTIFICATIONS {
        bigint id PK
        bigint customer_id FK
        string type
        string channel
        string status
        string related_entity_type
        bigint related_entity_id
        datetime sent_at
        datetime created_at
        datetime updated_at
    }

    AUDIT_LOGS {
        bigint id PK
        bigint actor_user_id FK
        string entity_type
        bigint entity_id
        string action
        json old_values
        json new_values
        json metadata
        datetime created_at
    }


    %% =========================================================
    %% RELATIONSHIPS
    %% =========================================================

    USERS ||--o| CUSTOMERS : has

    USERS ||--o{ USER_ROLES : assigned
    ROLES ||--o{ USER_ROLES : contains

    USERS ||--o{ AUDIT_LOGS : performs

    CUSTOMERS ||--o{ ADDRESSES : has
    CUSTOMERS ||--o{ TRAVELER_PROFILES : owns

    CUSTOMERS ||--o{ FLIGHT_BOOKINGS : creates
    CUSTOMERS ||--o{ HOTEL_BOOKINGS : creates
    CUSTOMERS ||--o{ TRANSACTIONS : owns
    CUSTOMERS ||--o{ NOTIFICATIONS : receives

    PROVIDERS ||--o{ FLIGHT_BOOKINGS : handles
    PROVIDERS ||--o{ HOTEL_BOOKINGS : handles
    PROVIDERS ||--o{ TRANSACTIONS : processes

    TRANSACTIONS ||--o| FLIGHT_BOOKINGS : linked_to
    TRANSACTIONS ||--o| HOTEL_BOOKINGS : linked_to

    FLIGHT_BOOKINGS ||--|{ FLIGHT_BOOKING_PASSENGERS : contains
    FLIGHT_BOOKINGS ||--|{ FLIGHT_SEGMENTS : contains
    FLIGHT_BOOKINGS ||--o{ FLIGHT_BOOKING_STATUS_HISTORY : transitions

    TRAVELER_PROFILES ||--o{ FLIGHT_BOOKING_PASSENGERS : source_profile
    TRAVELER_PROFILES ||--o{ HOTEL_BOOKING_GUESTS : source_profile

    HOTEL_BOOKINGS ||--|{ HOTEL_BOOKING_GUESTS : contains
    HOTEL_BOOKINGS ||--|{ HOTEL_BOOKING_ROOMS : contains
    HOTEL_BOOKINGS ||--o{ HOTEL_BOOKING_STATUS_HISTORY : transitions

    HOTEL_BOOKING_ROOMS ||--o{ HOTEL_BOOKING_ROOM_GUESTS : assigns
    HOTEL_BOOKING_GUESTS ||--o{ HOTEL_BOOKING_ROOM_GUESTS : assigned_to



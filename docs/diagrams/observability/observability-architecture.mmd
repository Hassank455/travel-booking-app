---
title: Observability Architecture – Travel Booking Platform
---
%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 40, "rankSpacing": 80, "padding": 10}, "themeVariables": {"fontFamily": "Inter, Segoe UI, Helvetica, Arial, sans-serif", "fontSize": "14px"}} }%%
flowchart LR

    subgraph Client["🖥️ Client"]
        direction TB
        WebApp["Customer Web Application"]
        MobileApp["Customer Mobile Application"]
    end

    subgraph Monitored["Monitored Components"]
        direction LR

        subgraph Backend["🧩 Backend Application · Modular Monolith"]
            direction TB
            SearchModule["🔎 Search Module"]
            BookingModule["🧾 Booking Module"]
            PaymentModule["💳 Payment Module"]
            NotificationModule["✉️ Notification Module"]
        end

        Broker["📨 Message Broker<br/><small>Async jobs</small>"]
        Workers["⚙️ Background Workers"]
        Database[("🗄️ PostgreSQL<br/><small>Persistent data</small>")]
        Redis[("⚡ Redis<br/><small>Cache · Locks · Idempotency</small>")]

        subgraph Providers["🔌 External Providers"]
            direction TB
            FlightProvider["✈️ Flight Providers"]
            HotelProvider["🏨 Hotel Providers"]
            PaymentGateway["🏦 Payment Gateway"]
            NotificationProvider["📬 Notification Provider"]
        end
    end

    subgraph ObservabilityPlatform["Observability Platform"]
        direction TB
        Logs["📝 Logs<br/><small>What happened?</small>"]
        Metrics["📊 Metrics<br/><small>Is something wrong?</small>"]
        Traces["🧭 Traces<br/><small>Where did it happen?</small>"]
        Dashboards["📈 Dashboards<br/><small>Operational visibility</small>"]
        Alerts["🚨 Alerts<br/><small>Actionable incidents</small>"]
    end

    %% ── Correlation Context: the request path that carries the Correlation ID ──
    WebApp ==>|"HTTPS Request<br/>Correlation ID created"| Backend
    MobileApp ==>|"HTTPS Request<br/>Correlation ID created"| Backend
    Backend ==>|"Publishes jobs"| Broker
    Broker ==>|"Delivers jobs"| Workers
    Backend ==>|"Reads / writes"| Database
    Backend ==>|"Cache · locks"| Redis
    Backend ==>|"Provider requests"| Providers
    Workers ==>|"Reads / writes"| Database
    Workers ==>|"Cache · locks"| Redis
    Workers ==>|"Reconciliation"| Providers

    %% ── Telemetry ──
    Backend -.->|"Structured Logs"| Logs
    Backend -.->|"Metrics"| Metrics
    Backend -.->|"Trace Spans"| Traces

    Workers -.->|"Worker Logs"| Logs
    Workers -.->|"Worker Metrics"| Metrics
    Workers -.->|"Worker Traces"| Traces

    Database -.-> Metrics
    Redis -.-> Metrics
    Broker -.-> Metrics
    Providers -.-> Metrics

    Logs --> Dashboards
    Metrics --> Dashboards
    Traces --> Dashboards

    Logs --> Alerts
    Metrics --> Alerts

    Legend["<b>Correlation Context</b><br/><small>The blue path carries one Correlation ID<br/>from the client request through every hop</small>"]

